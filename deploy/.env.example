# Production settings for deploy/compose.prod.yml and the backup scripts.
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env    # then fill in the values
# deploy/.env is ignored by git and by the Docker build context. Never commit it.
#
# Format: plain KEY=value, no quotes, no spaces around '=' — the same file is read by docker compose and by systemd
# (EnvironmentFile= in deploy/backup/mq-backup.service), and only this form means the same thing to both.

# --- site ----------------------------------------------------------------------------------------------------------
# Domain name whose A record points at this VPS. Caddy gets a Let's Encrypt certificate for it on first start.
# DOMAIN=localhost uses Caddy's local CA instead (testing on a laptop).
DOMAIN=example.ru
# Address for Let's Encrypt expiry notices.
ACME_EMAIL=admin@example.ru

# --- database ------------------------------------------------------------------------------------------------------
# Password of the Postgres user `mq`. It goes into a URL, so use letters and digits only:  openssl rand -hex 24
# Changing it later in this file does not change it in an existing database (see docs/ops.md).
POSTGRES_PASSWORD=

# --- API (docs/contracts/layout.md) --------------------------------------------------------------------------------
# PORT, DATABASE_URL and STATIC_DIR are set by compose.prod.yml and the image; BUILD by `make up-prod` (git sha).
# Extra CORS origins, comma-separated (e.g. the GitHub Pages site during tests). Same-origin needs none.
ALLOWED_ORIGINS=
# Basic auth for /admin. Without both, /admin answers 404.  Password: openssl rand -base64 18
ADMIN_USER=
ADMIN_PASSWORD=

# --- backups (deploy/backup/backup.sh) -----------------------------------------------------------------------------
# Where dumps are written on the VPS, and how many days to keep them there.
BACKUP_DIR=/var/backups/mq
BACKUP_KEEP_DAYS=14
# Optional off-site copy to S3-compatible storage in Russia (Selectel, Yandex Object Storage). Pick one way or none.
# a) rclone: name of a configured remote plus bucket/path (configure it with `rclone config` as root):
BACKUP_RCLONE_REMOTE=
#    e.g. BACKUP_RCLONE_REMOTE=selectel:mq-backups/db
# b) aws CLI: bucket/prefix and endpoint; keys below, or in ~/.aws/credentials of root.
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
#    Selectel:       BACKUP_S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru     (region ru-1)
#    Yandex Cloud:   BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net         (region ru-central1)
#    e.g. BACKUP_S3_URI=s3://mq-backups/db
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-1
